# Optional reference file. Most users should just launch Iris and complete the
# onboarding wizard (gear icon -> Settings -> Run setup wizard), which saves these
# values to ~/.iris/.env for you. Editing files by hand is only for power users.

GEMINI_API_KEY=your_google_ai_studio_key

# Optional overrides
IRIS_USER_NAME=there
IRIS_LOAD_TEST_DATA=false

# Iris injects a small stable USER.md profile into Gemini. Episodic MEMORY.md
# and brain-vault notes are searched/read only when relevant, with source and
# freshness metadata. One shared source of truth, no copying.
# HERMES_HOME=~/.hermes   # override only if Hermes lives somewhere else
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Zephyr
IRIS_WAKE_WORD=true
IRIS_WAKE_SENSITIVITY=balanced
IRIS_SHOW_WAKE_DIAGNOSTICS=false
HERMES_API_URL=http://127.0.0.1:8642

# Default: Iris starts Hermes's authenticated TUI Gateway backend and receives
# the full interactive protocol (clarify, approval, sudo, and secret prompts).
# Set runs_api only as a legacy compatibility fallback.
IRIS_HERMES_TRANSPORT=interactive
# Leave unset to use Hermes's own terminal.cwd (recommended). Set only when you
# deliberately want every new Iris session anchored to a specific workspace.
# IRIS_HERMES_CWD=/path/to/safe/workspace
# Comma-separated locations Hermes must not inspect unless the user explicitly
# names one in the task. Downloads is intentionally not blocked by default.
# IRIS_HERMES_PROTECTED_PATHS=~/Documents,~/Desktop,~/Pictures,~/Applications,/Applications,~/Library,~/Movies,~/Music

# Strong secret required: Hermes refuses to start its API server with a key
# shorter than 16 chars (the endpoint dispatches terminal-capable agent work).
# Generate one with `openssl rand -hex 32` and use the SAME value in
# ~/.hermes/.env — the two sides must match.
API_SERVER_KEY=<generate with: openssl rand -hex 32>

# Stable long-term-memory scope sent in X-Hermes-Session-Key. Transcript threads
# can change without fragmenting Hermes's learned memory. Usually auto-derived.
# IRIS_HERMES_MEMORY_KEY=iris:desktop:your-name

# If the Hermes API is unreachable when Iris starts, Iris starts/restarts the
# Hermes gateway automatically (launchd service on macOS, else the hermes CLI).
# Set to false if you prefer to manage the gateway yourself.
IRIS_HERMES_AUTOSTART=true

# Cost control. An idle Live session streams silence at ~25 tokens/sec AND
# re-bills the accumulated audio context on every turn — standby closes the
# session after this many seconds without speech (0 = never). Waking, whether
# by you or by a finished Hermes task (IRIS_AUTO_WAKE_ON_HERMES), opens a new
# session in about a second and carries the conversation across from the
# journal below, so a nap of any length picks up where you left off.
IRIS_AUTO_SLEEP_SECONDS=30
IRIS_AUTO_WAKE_ON_HERMES=true

# A live session only holds the last few minutes of speech — the window is
# compressed so long sessions stay affordable and are never cut off at Google's
# 15-minute audio limit. So that Iris can still answer "what did we decide this
# morning?", each conversation is summarised to a few lines in
# ~/.iris/journal/YYYY-MM-DD.md on this machine and nowhere else: one file per
# day, headed with the weekday and date, holding one numbered section per
# session with the times it ran and a summary under each. The same turns are
# indexed in ~/.iris/conversations.db, keyed by the Hermes chat they were
# spoken in, which is what restores the Comms panel when you reopen the app.
# Iris reads that thread's summaries at wake and searches older ones on
# request. On by default. Set to false to keep no record at all — waking stays
# quick, but each session begins knowing nothing of the earlier ones and the
# Comms panel starts empty. Delete both to erase what exists.
IRIS_CONVERSATION_JOURNAL=true
# How long the underlying spoken lines and the summaries are kept, in days.
# The lines are what the Comms panel scrolls back through, so this is also how
# far back a restored conversation goes; the summaries are what Iris recalls
# from further back than that.
IRIS_JOURNAL_RAW_DAYS=30
IRIS_JOURNAL_DIGEST_DAYS=90
# Model used for the one-shot summary written when a conversation ends. Not on
# the voice path; if the call fails, a plain text fallback is written instead.
IRIS_DIGEST_MODEL=gemini-flash-lite-latest
# Append-only record of every wake and its connect time, at
# ~/.iris/session-log.jsonl. Diagnostics only; useful when a wake misbehaves.
IRIS_SESSION_LOG=true

# Optional: full path to the Hermes binary if your packaged GUI app cannot find
# it on PATH. Also used by the autostart above. Usually not required when the
# Hermes gateway is already running or installed as a service.
# macOS/Linux example:
# HERMES_BIN=/home/you/.local/bin/hermes
# Windows example:
# HERMES_BIN=C:\\Users\\you\\AppData\\Local\\Programs\\hermes\\hermes.exe
